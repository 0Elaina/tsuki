<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nep.tsuki.category.mapper.CategoryMapper">
    <select id="selectByIdsForUpdate" resultType="com.nep.tsuki.category.model.entity.Category">
        SELECT id, name, sort_order, status, created_at, updated_at
        FROM categories
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY id ASC
        FOR UPDATE
    </select>
</mapper>