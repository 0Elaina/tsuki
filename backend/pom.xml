<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.nep.tsuki</groupId>
	<artifactId>tsuki-parent</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<modules>
		<module>tsuki-app</module>
		<module>tsuki-common</module>
		<module>tsuki-user</module>
		<module>tsuki-auth</module>
	</modules>
	<name>tsuki-parent</name>

	<properties>
		<java.version>21</java.version>
		<spring-boot.run.skip>true</spring-boot.run.skip>
	</properties>
	<dependencyManagement>
		<dependencies>
			<!-- 内部子模块统一版本 -->
			<dependency>
				<groupId>com.nep.tsuki</groupId>
				<artifactId>tsuki-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.nep.tsuki</groupId>
				<artifactId>tsuki-user</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.nep.tsuki</groupId>
				<artifactId>tsuki-auth</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.nep.tsuki</groupId>
				<artifactId>tsuki-app</artifactId>
				<version>${project.version}</version>
			</dependency>

			<dependency>
				<groupId>com.baomidou</groupId>
				<artifactId>mybatis-plus-bom</artifactId>
				<version>3.5.18.1</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>